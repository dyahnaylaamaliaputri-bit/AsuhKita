# ============================================================
# AsuhKita Backend — Environment Variables Template
# JANGAN isi file ini dengan nilai asli, gunakan .env (di-gitignore)
# ============================================================

# ---- SERVER ----
PORT=3000
NODE_ENV=development

# ---- DATABASE SUPABASE (PostgreSQL) ----
# Dapatkan dari: Supabase Dashboard → Project → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres.aigrpoxfjwyequzcuzda:Teorimobile3%23@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ---- JWT SECRET ----
# Buat string acak panjang, misal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=ganti_dengan_random_string_panjang_64char
JWT_REFRESH_SECRET=ganti_dengan_random_string_lain_64char

# ---- JWT EXPIRY ----
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- BCRYPT ----
BCRYPT_SALT_ROUNDS=12

# ---- IoT DEVICE (HMAC) ----
# Secret digunakan ESP32 untuk sign event HMAC-SHA256
IOT_DEVICE_SECRET=ganti_dengan_secret_iot_device

# ---- AI / LLM ----
# Simpan API key di sini, JANGAN di kode Flutter
OPENAI_API_KEY=sk-...

# ---- CURRENCY API ----
# Frankfurter tidak butuh key (free), ExchangeRate-API butuh key
EXCHANGERATE_API_KEY=optional_jika_pakai_exchangerate_api
